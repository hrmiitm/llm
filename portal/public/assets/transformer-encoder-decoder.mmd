flowchart LR
    SRC[Source tokens] --> SE[Source embedding + position]
    SE --> ENC[Encoder self-attention and FFN]
    ENC --> H[Encoder states H]
    TGT[Target tokens shifted right] --> DE[Target embedding + position]
    DE --> M[Masked decoder self-attention]
    M --> CA[Cross-attention]
    H -->|keys and values| CA
    CA --> FF[Decoder FFN]
    FF --> OUT[Linear projection + softmax]

    classDef input fill:#e8f1ff,stroke:#1355a6,color:#102a43;
    classDef block fill:#fff4e5,stroke:#d97706,color:#5b3500;
    classDef output fill:#ecfdf5,stroke:#15803d,color:#14532d;
    class SRC,TGT input;
    class SE,ENC,DE,M,CA,FF block;
    class H,OUT output;
